{
  "name": "neoskin-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Shared frontend for Blessing Skin Server 6.0.11 ports",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev:site": "pnpm --filter @neoskin/site dev",
    "dev:admin": "pnpm --filter @neoskin/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "preview:mock": "node scripts/mock-server.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "publish:app": "pwsh -File scripts/publish.ps1"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
